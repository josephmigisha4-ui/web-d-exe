

header {

    background: #071a33;

    padding: 18px 8%;

    display: flex;

    justify-content: space-between;

    align-items: center;

    position: sticky;

    top: 0;

    z-index: 1000;
}




.logo {

    color: white;

    font-size: 24px;

    font-weight: bold;

    letter-spacing: 2px;
}


.logo span {

    color: #22c55e;
}



/* NAVIGATION */

nav {

    display: flex;

    gap: 30px;
}


nav a {

    color: white;

    text-decoration: none;

    font-weight: bold;

    transition: 0.3s;
}


nav a:hover {

    color: #22c55e;
}


nav a.active {

    color: #22c55e;

    border-bottom: 2px solid #22c55e;

    padding-bottom: 5px;
}





.hero {

    max-width: 1200px;

    margin: auto;

    min-height: 600px;

    padding: 70px 30px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 60px;

    align-items: center;
}


.hero-text {

    padding: 20px;
}


.welcome {

    color: #16a34a;

    font-weight: bold;

    letter-spacing: 4px;

    margin-bottom: 10px;
}


.hero h1 {

    color: #071a33;

    font-size: 55px;

    line-height: 1.1;

    margin-bottom: 25px;
}


.hero h1 span {

    color: #16a34a;
}


.hero-text > p:not(.welcome) {

    font-size: 18px;

    margin-bottom: 30px;

    color: #4b5563;
}


/* BUTTON */

.btn {

    display: inline-block;

    background: #16a34a;

    color: white;

    padding: 14px 25px;

    text-decoration: none;

    border-radius: 7px;

    font-weight: bold;

    transition: 0.3s;
}


.btn:hover {

    background: #0f7a36;

    transform: translateY(-2px);
}





.about {

    background: white;

    text-align: center;

    padding: 80px 8%;
}


.about h2 {

    color: #071a33;

    font-size: 36px;

    margin-bottom: 20px;
}


.about > p {

    max-width: 850px;

    margin: 10px auto;

    color: #555;
}






.card h3 {

    color: #071a33;

    margin-bottom: 10px;
}





.directors {

    max-width: 1200px;

    margin: auto;

    padding: 80px 30px;

    text-align: center;
}


.directors h2 {

    color: #071a33;

    font-size: 36px;

    margin-bottom: 10px;
}


.subtitle {

    color: #666;

    margin-bottom: 40px;
}


.director-container {

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;
}


.director-card {

    background: white;

    padding: 30px;

    border-radius: 15px;

    box-shadow:
        0 8px 25px
        rgba(0, 0, 0, 0.08);

    transition: 0.3s;
}


.director-card:hover {

    transform: translateY(-8px);

    box-shadow:
        0 15px 30px
        rgba(0, 0, 0, 0.12);
}




.director-card img {

    width: 160px;

    height: 160px;

    border-radius: 50%;

    object-fit: cover;

    border: 5px solid #16a34a;

    margin-bottom: 20px;
}


.director-card h3 {

    color: #071a33;

    margin-bottom: 10px;

    font-size: 21px;
}


.director-card p {

    margin: 7px 0;

    color: #555;
}


.page-title {

    background: #071a33;

    color: white;

    text-align: center;

    padding: 80px 20px;
}


.page-title h1 {

    color: #22c55e;

    font-size: 48px;

    margin-bottom: 10px;
}


.page-title p {

    font-size: 18px;
}

.services {

    max-width: 1200px;

    margin: auto;

    padding: 80px 30px;

    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;
}



.service-icon {

    font-size: 50px;

    margin-bottom: 15px;
}


.


.service-card p {

    color: #666;
}



.contact-section {

    max-width: 1200px;

    margin: auto;

    padding: 80px 30px;

    display: grid;

    grid-template-columns: 1fr 1fr;

    gap: 35px;
}


.contact-info,
.contact-form {

    background: white;

    padding: 40px;

    border-radius: 15px;

    box-shadow:
        0 8px 25px
        rgba(0, 0, 0, 0.08);
}



.contact-info p {

    margin-bottom: 15px;

    color: #555;
}




.contact-form form {

    display: flex;

    flex-direction: column;
}


.contact-form label {

    font-weight: bold;

    margin-top: 12px;

    margin-bottom: 5px;
}


.contact-form input,
.contact-form textarea {

    width: 100%;

    padding: 13px;

    border: 1px solid #d1d5db;

    border-radius: 6px;

    font-size: 15px;

    font-family: Arial, sans-serif;
}


footer {

    background: #071a33;

    color: white;

    text-align: center;

    padding: 35px 20px;

    margin-top: 20px;
}


footer h3 {

    color: #22c55e;

    margin-bottom: 10px;
}


footer p {

    margin: 5px;
}


@media (max-width: 850px) {


    header {

        flex-direction: column;

        gap: 15px;
    }


    nav {

        gap: 18px;
    }


    .hero {

        grid-template-columns: 1fr;

        text-align: center;
    }


    .hero h1 {

        font-size: 42px;
    }


    .business-cards {

        grid-template-columns: 1fr;
    }


    .director-container {

        grid-template-columns: 1fr;
    }


    .services {

        grid-template-columns: 1fr;
    }


    .contact-section {

        grid-template-columns: 1fr;
    }

}


@media (max-width: 500px) {


    .logo {

        font-size: 20px;
    }


    nav {

        flex-direction: column;

        text-align: center;

        gap: 10px;
    }


    .hero {

        padding: 45px 20px;
    }


    .hero h1 {

        font-size: 35px;
    }


    .hero-image img {

        height: 270px;
    }


    .page-title h1 {

        font-size: 38px;
    }

}